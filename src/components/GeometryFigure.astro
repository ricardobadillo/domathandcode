---
type Pair = [number, number];

interface SegmentElement {
  type: 'segment';
  from: Pair;
  to: Pair;
  color?: string;
  width?: number;
  dash?: boolean;
}

interface PolylineElement {
  type: 'polyline';
  points: Pair[];
  closed?: boolean;
  fill?: string;
  color?: string;
  width?: number;
  dash?: boolean;
}

interface CircleElement {
  type: 'circle';
  center: Pair;
  r: number;
  fill?: string;
  color?: string;
  width?: number;
  dash?: boolean;
}

interface EllipseElement {
  type: 'ellipse';
  center: Pair;
  rx: number;
  ry: number;
  fill?: string;
  color?: string;
  width?: number;
  dash?: boolean;
}

interface PointElement {
  type: 'point';
  at: Pair;
  label?: string;
  labelOffset?: Pair;
  color?: string;
  r?: number;
  hollow?: boolean;
}

interface AngleElement {
  type: 'angle';
  at: Pair;
  from: Pair;
  to: Pair;
  radius?: number;
  label?: string;
  labelOffset?: number;
  right?: boolean;
  color?: string;
}

interface TickElement {
  type: 'tick';
  from: Pair;
  to: Pair;
  t?: number;
  count?: number;
  size?: number;
  gap?: number;
  color?: string;
}

interface LabelElement {
  type: 'label';
  at: Pair;
  text: string;
  anchor?: 'start' | 'middle' | 'end';
  color?: string;
  size?: number;
}

interface ArrowElement {
  type: 'arrow';
  from: Pair;
  to: Pair;
  color?: string;
  width?: number;
}

type GeometryElement =
  | SegmentElement
  | PolylineElement
  | CircleElement
  | EllipseElement
  | PointElement
  | AngleElement
  | TickElement
  | LabelElement
  | ArrowElement;

interface Props {
  elements: GeometryElement[];
  width?: number;
  height?: number;
  viewBox?: string;
  caption?: string;
  ariaLabel?: string;
}

const { elements = [], width = 420, height = 320, viewBox = `0 0 ${width} ${height}`, caption, ariaLabel } =
  Astro.props;

const sub = (a: Pair, b: Pair): Pair => [a[0] - b[0], a[1] - b[1]];
const add = (a: Pair, b: Pair): Pair => [a[0] + b[0], a[1] + b[1]];
const scale = (a: Pair, s: number): Pair => [a[0] * s, a[1] * s];
const length = (a: Pair) => Math.hypot(a[0], a[1]);
const normalize = (a: Pair): Pair => {
  const l = length(a) || 1;
  return [a[0] / l, a[1] / l];
};
const lerp = (a: Pair, b: Pair, t: number): Pair => [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t];
const fmt = (n: number) => Math.round(n * 100) / 100;

const lines: { x1: number; y1: number; x2: number; y2: number; color: string; width: number; dash: boolean }[] = [];
const paths: { d: string; color: string; width: number; dash: boolean; fill: string }[] = [];
const circles: { cx: number; cy: number; r: number; color: string; width: number; dash: boolean; fill: string }[] = [];
const ellipses: { cx: number; cy: number; rx: number; ry: number; color: string; width: number; dash: boolean; fill: string }[] = [];
const dots: { cx: number; cy: number; r: number; color: string; hollow: boolean }[] = [];
const texts: { x: number; y: number; text: string; anchor: string; color: string; size: number }[] = [];

for (const element of elements) {
  const color = element.color ?? 'currentColor';

  if (element.type === 'segment') {
    lines.push({
      x1: element.from[0],
      y1: element.from[1],
      x2: element.to[0],
      y2: element.to[1],
      color,
      width: element.width ?? 1.8,
      dash: element.dash ?? false,
    });
  } else if (element.type === 'polyline') {
    const points = element.points.map((p) => `${fmt(p[0])} ${fmt(p[1])}`).join(' L');
    const d = `M${points}${element.closed ? ' Z' : ''}`;
    paths.push({
      d,
      color,
      width: element.width ?? 1.8,
      dash: element.dash ?? false,
      fill: element.fill ?? 'none',
    });
  } else if (element.type === 'circle') {
    circles.push({
      cx: element.center[0],
      cy: element.center[1],
      r: element.r,
      color,
      width: element.width ?? 1.8,
      dash: element.dash ?? false,
      fill: element.fill ?? 'none',
    });
  } else if (element.type === 'ellipse') {
    ellipses.push({
      cx: element.center[0],
      cy: element.center[1],
      rx: element.rx,
      ry: element.ry,
      color,
      width: element.width ?? 1.8,
      dash: element.dash ?? false,
      fill: element.fill ?? 'none',
    });
  } else if (element.type === 'point') {
    dots.push({
      cx: element.at[0],
      cy: element.at[1],
      r: element.r ?? 3.5,
      color,
      hollow: element.hollow ?? false,
    });
    if (element.label) {
      const [dx, dy] = element.labelOffset ?? [0, -10];
      texts.push({
        x: element.at[0] + dx,
        y: element.at[1] + dy,
        text: element.label,
        anchor: 'middle',
        color,
        size: 15,
      });
    }
  } else if (element.type === 'angle') {
    const u = normalize(sub(element.from, element.at));
    const v = normalize(sub(element.to, element.at));
    if (element.right) {
      const s = element.radius ?? 15;
      const p1 = add(element.at, scale(u, s));
      const p2 = add(p1, scale(v, s));
      const p3 = add(element.at, scale(v, s));
      paths.push({
        d: `M${fmt(p1[0])} ${fmt(p1[1])} L${fmt(p2[0])} ${fmt(p2[1])} L${fmt(p3[0])} ${fmt(p3[1])}`,
        color,
        width: 1.5,
        dash: false,
        fill: 'none',
      });
    } else {
      const r = element.radius ?? 30;
      const a1 = Math.atan2(u[1], u[0]);
      const a2 = Math.atan2(v[1], v[0]);
      let delta = a2 - a1;
      while (delta <= -Math.PI) delta += 2 * Math.PI;
      while (delta > Math.PI) delta -= 2 * Math.PI;
      const start = add(element.at, scale(u, r));
      const end = add(element.at, scale(v, r));
      const largeArc = Math.abs(delta) > Math.PI ? 1 : 0;
      const sweep = delta > 0 ? 1 : 0;
      paths.push({
        d: `M${fmt(start[0])} ${fmt(start[1])} A${r} ${r} 0 ${largeArc} ${sweep} ${fmt(end[0])} ${fmt(end[1])}`,
        color,
        width: 1.5,
        dash: false,
        fill: 'none',
      });
      if (element.label) {
        let bisector = add(u, v);
        if (length(bisector) < 1e-6) bisector = [-u[1], u[0]];
        bisector = normalize(bisector);
        const offset = r + (element.labelOffset ?? 16);
        const pos = add(element.at, scale(bisector, offset));
        texts.push({
          x: pos[0],
          y: pos[1] + 4,
          text: element.label,
          anchor: 'middle',
          color,
          size: 15,
        });
      }
    }
  } else if (element.type === 'tick') {
    const d = normalize(sub(element.to, element.from));
    const perp: Pair = [-d[1], d[0]];
    const count = element.count ?? 1;
    const size = element.size ?? 10;
    const gap = element.gap ?? size * 0.9;
    const center = lerp(element.from, element.to, element.t ?? 0.5);
    for (let i = 0; i < count; i++) {
      const offset = (i - (count - 1) / 2) * gap;
      const c = add(center, scale(d, offset));
      const a = add(c, scale(perp, size / 2));
      const b = add(c, scale(perp, -size / 2));
      lines.push({ x1: a[0], y1: a[1], x2: b[0], y2: b[1], color, width: 1.5, dash: false });
    }
  } else if (element.type === 'label') {
    texts.push({
      x: element.at[0],
      y: element.at[1],
      text: element.text,
      anchor: element.anchor ?? 'middle',
      color,
      size: element.size ?? 14,
    });
  } else if (element.type === 'arrow') {
    const d = normalize(sub(element.to, element.from));
    const perp: Pair = [-d[1], d[0]];
    const headLength = 11;
    const headWidth = 5;
    const base = add(element.to, scale(d, -headLength));
    const p1 = add(base, scale(perp, headWidth));
    const p2 = add(base, scale(perp, -headWidth));
    lines.push({
      x1: element.from[0],
      y1: element.from[1],
      x2: element.to[0],
      y2: element.to[1],
      color,
      width: element.width ?? 1.8,
      dash: false,
    });
    paths.push({
      d: `M${fmt(element.to[0])} ${fmt(element.to[1])} L${fmt(p1[0])} ${fmt(p1[1])} L${fmt(p2[0])} ${fmt(p2[1])} Z`,
      color,
      width: 1,
      dash: false,
      fill: color,
    });
  }
}

const description = ariaLabel ?? caption ?? 'Figura geométrica';
---

<figure class="geometry-figure">
  <svg
    viewBox={viewBox}
    role="img"
    aria-label={description}
    xmlns="http://www.w3.org/2000/svg"
  >
    <title>{description}</title>

    {circles.map((circle) => (
      <circle
        cx={circle.cx}
        cy={circle.cy}
        r={circle.r}
        fill={circle.fill}
        stroke={circle.color}
        stroke-width={circle.width}
        stroke-dasharray={circle.dash ? '6 5' : undefined}
      />
    ))}

    {ellipses.map((ellipse) => (
      <ellipse
        cx={ellipse.cx}
        cy={ellipse.cy}
        rx={ellipse.rx}
        ry={ellipse.ry}
        fill={ellipse.fill}
        stroke={ellipse.color}
        stroke-width={ellipse.width}
        stroke-dasharray={ellipse.dash ? '6 5' : undefined}
      />
    ))}

    {lines.map((line) => (
      <line
        x1={line.x1}
        y1={line.y1}
        x2={line.x2}
        y2={line.y2}
        stroke={line.color}
        stroke-width={line.width}
        stroke-dasharray={line.dash ? '6 5' : undefined}
        stroke-linecap="round"
      />
    ))}

    {paths.map((path) => (
      <path
        d={path.d}
        fill={path.fill}
        stroke={path.color}
        stroke-width={path.width}
        stroke-dasharray={path.dash ? '6 5' : undefined}
        stroke-linejoin="round"
        stroke-linecap="round"
      />
    ))}

    {dots.map((dot) => (
      <circle
        cx={dot.cx}
        cy={dot.cy}
        r={dot.r}
        fill={dot.hollow ? 'var(--sl-color-bg)' : dot.color}
        stroke={dot.color}
        stroke-width={dot.hollow ? 1.5 : undefined}
      />
    ))}

    {texts.map((text) => (
      <text
        x={text.x}
        y={text.y}
        text-anchor={text.anchor}
        fill={text.color}
        font-size={text.size}
        font-style="italic"
      >
        {text.text}
      </text>
    ))}
  </svg>

  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .geometry-figure {
    margin: 1.5rem 0;
  }

  .geometry-figure svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .geometry-figure text {
    font-family: var(--sl-font);
  }

  figcaption {
    margin-top: 0.5rem;
    text-align: center;
    color: var(--sl-color-gray-2);
    font-size: 0.95rem;
  }
</style>
